#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# Load project environment (DATABASE_URL, PATH, secrets)
source env.sh

PROXY_URL="${PROXY_URL:-http://localhost:4000}"

# --- Check that the proxy is up ---
echo "Checking proxy at $PROXY_URL/v1/models ..."
if ! curl -sf "$PROXY_URL/v1/models" -o /dev/null; then
	echo "ERROR: Proxy is not reachable at $PROXY_URL/v1/models"
	echo "Start the proxy first with: bin/dev  or  bin/run"
	exit 1
fi

# --- Fetch model list ---
echo "Fetching model list ..."
MODELS_JSON=$(curl -sf "$PROXY_URL/v1/models")
MODEL_IDS=$(echo "$MODELS_JSON" | jq -r '.data[].id' 2>/dev/null)

if [ -z "$MODEL_IDS" ]; then
	echo "ERROR: No models found in /v1/models response"
	echo "$MODELS_JSON" | head -20
	exit 1
fi

MODEL_COUNT=$(echo "$MODEL_IDS" | wc -l | tr -d ' ')
echo "Found $MODEL_COUNT models"

# --- Research each model via pi ---
CURRENT=0
SUCCESS=0
FAILED=0

while IFS= read -r MODEL_ID; do
	CURRENT=$((CURRENT + 1))
	echo ""
	echo "[$CURRENT/$MODEL_COUNT] Researching: $MODEL_ID"

	# Build the prompt for pi
	PROMPT="Research the AI model \"$MODEL_ID\" and return ONLY a JSON object with these fields:
- contextSize: maximum context window size in tokens (integer or null if unknown)
- samplingPresets: array of recommended sampling parameter presets, each with {name, description, params}. params can include temperature, top_p, top_k, max_tokens, etc. Use an empty array if none found.
- description: a one-sentence description of the model
- source: the URL where you found this information (e.g. HuggingFace model card)

Use web search or browser tools to find this information from official sources like HuggingFace model cards, documentation, or technical reports.

Return ONLY the JSON object, no markdown fences, no commentary. Example:
{\"contextSize\": 131072, \"samplingPresets\": [{\"name\": \"default\", \"description\": \"General purpose\", \"params\": {\"temperature\": 0.7, \"top_p\": 0.95}}], \"description\": \"A large language model by ...\", \"source\": \"https://huggingface.co/...\"}"

	# Run pi in non-interactive print mode
	if PI_OUTPUT=$(pi -p --no-session "$PROMPT" 2>/dev/null); then
		# Try to extract JSON from the output (pi might wrap it in markdown fences)
		JSON_OUTPUT=$(echo "$PI_OUTPUT" | sed -n '/^{/,/^}/p' | head -200)
		if [ -z "$JSON_OUTPUT" ]; then
			# Try extracting from markdown code fences
			JSON_OUTPUT=$(echo "$PI_OUTPUT" | sed -n '/^```/,/^```/p' | sed '1d;$d' | head -200)
		fi

		if [ -n "$JSON_OUTPUT" ]; then
			# Validate it's parseable JSON
			if echo "$JSON_OUTPUT" | jq . >/dev/null 2>&1; then
				echo "  ✓ Got valid metadata"
				# Upsert via bun script
				bun run src/research-models-upsert.ts "$MODEL_ID" "$JSON_OUTPUT" && SUCCESS=$((SUCCESS + 1)) || FAILED=$((FAILED + 1))
			else
				echo "  ✗ Invalid JSON output, skipping"
				FAILED=$((FAILED + 1))
			fi
		else
			echo "  ✗ No JSON found in pi output, skipping"
			FAILED=$((FAILED + 1))
		fi
	else
		echo "  ✗ pi command failed, skipping"
		FAILED=$((FAILED + 1))
	fi
done <<<"$MODEL_IDS"

echo ""
echo "========================================"
echo "Research complete: $SUCCESS succeeded, $FAILED failed out of $MODEL_COUNT models"
echo "========================================"
