#!/bin/bash
set -e

cd $PROJECT_ROOT

source env.sh

echo "=== codegen ==="
# Prisma 7 no longer generates the client on install.
bunx prisma generate
bun run codegen

echo "=== format ==="
format

echo "=== typecheck ==="
typecheck

echo "=== test ==="
"$PROJECT_ROOT/bin/test"

echo "=== test-frontend ==="
"$PROJECT_ROOT/bin/test-frontend"
