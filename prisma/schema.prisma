datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ModelMeta {
  id              String   @id @default(cuid())
  modelId         String   @unique
  contextSize     Int?
  samplingPresets String   @default("[]")
  description     String?
  source          String?
  researchedAt    DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PendingJob {
  id               String    @id @default(cuid())
  sailResponseId   String    @unique
  status           String    @default("pending")
  requestBody      String
  model            String
  apiType          String    @default("chat-completions")
  completionWindow String
  responseBody     String?
  errorBody        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  sailBodyHash     String?
  completedAt      DateTime?
  pollCount        Int       @default(0)
  nextPollAt       DateTime  @default(now())

  @@index([status, nextPollAt])
  @@index([sailBodyHash])
  @@index([createdAt])
}
