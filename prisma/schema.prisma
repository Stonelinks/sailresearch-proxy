datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

generator pothos {
  provider = "prisma-pothos-types"
}

model ModelMeta {
  id              String           @id @default(cuid())
  modelId         String           @unique
  contextSize     Int?
  description     String?
  source          String?
  supportsImage   Boolean         @default(false)
  reasoning       Boolean         @default(false)
  thinkingLevelMap String?
  researchedAt    DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  samplingPresets SamplingPreset[]
  prices          ModelPrice[]
}

model ModelPrice {
  id                 String   @id @default(cuid())
  modelMetaId        String
  completionWindow   String
  inputPerMTok       Float
  cachedInputPerMTok Float?
  outputPerMTok      Float
  currency           String   @default("USD")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  modelMeta ModelMeta @relation(fields: [modelMetaId], references: [id], onDelete: Cascade)

  @@unique([modelMetaId, completionWindow])
  @@index([modelMetaId])
}

model SamplingPreset {
  id          String    @id @default(cuid())
  modelMetaId String
  name        String
  description String    @default("")
  params      String    @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  modelMeta   ModelMeta @relation(fields: [modelMetaId], references: [id], onDelete: Cascade)

  @@index([modelMetaId])
}

model PendingJob {
  id               String    @id @default(cuid())
  sailResponseId   String    @unique
  status           String    @default("pending")
  requestBody      String
  model            String
  apiType          String    @default("chat-completions")
  completionWindow String
  responseBody     String?
  errorBody        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  sailBodyHash     String?
  completedAt      DateTime?
  pollCount        BigInt    @default(0)
  nextPollAt       DateTime  @default(now())

  @@index([status, nextPollAt])
  @@index([sailBodyHash])
  @@index([createdAt])
}
