{
  "name": "sailresearch-proxy",
  "version": "0.1.0",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "run": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test",
    "test:slow": "SAIL_SLOW_INTEGRATION=1 bun test",
    "db:push": "bunx prisma db push",
    "db:studio": "bunx prisma studio",
    "codegen:schema": "bun run src/graphql/codegen.ts",
    "codegen:client": "cd frontend && bunx houdini generate",
    "codegen": "bun run codegen:schema && bun run codegen:client"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.8.1",
    "typescript": "^6"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.1",
    "@pothos/core": "^4.12.0",
    "@prisma/adapter-libsql": "7.10.1",
    "@prisma/client": "7.10.1",
    "graphql": "^16.13.2",
    "graphql-ws": "^6.0.8",
    "graphql-yoga": "^6.1.1",
    "prisma": "7.10.1",
    "winston": "^3.19.0"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
