# Required
SAIL_API_KEY=sk-sail-...

# Sail API
SAIL_BASE_URL=https://api.sailresearch.com/v1

# Server
PORT=4000
HOST=0.0.0.0

# Defaults
DEFAULT_COMPLETION_WINDOW=standard
DEFAULT_MODEL=zai-org/GLM-5.2-FP8

# Per-window client-side caps (ms) for research window smoke tests.
# The proxy applies no timeout to forwarded requests.
TIMEOUT_PRIORITY_MS=300000
TIMEOUT_STANDARD_MS=1800000
TIMEOUT_FLEX_MS=7200000

# Logging: debug | info (default) | warn | error
LOG_LEVEL=info

# Database (env.sh sets this automatically with absolute path)
# DATABASE_URL=file:/absolute/path/to/data/proxy.db

# Log directory (env.sh sets this automatically with absolute path)
# LOG_DIR=/absolute/path/to/data/logs

# Optional: protect the proxy itself
PROXY_API_KEY=
